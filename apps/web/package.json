{
  "name": "@tracker/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" payload migrate && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-vercel-blob": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@tracker/shared": "*",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "^5.9.0"
  }
}
